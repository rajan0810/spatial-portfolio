# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ — that would publish it.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → connection string (used by drizzle-kit)
DATABASE_URL=

# Allow-listed admin for magic-link login and the DB allow-list.
ADMIN_EMAIL=

# Salts the IP hash used to rate-limit drops. Any long random string.
DROP_SALT=
